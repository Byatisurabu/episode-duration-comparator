{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI: uvicorn debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",           // путь к твоему ASGI-приложению
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload",
                "--reload-dir", "."       // опционально — следить за изменениями во всём проекте
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "DEBUG": "true"           // если используешь logging / debug в FastAPI
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}